# rename this file to `.env` and fill in the values

# set bot logger level
# available levels: info, warn, error, fatal, silent
BOT_LOGGER_LEVEL=silent

# set whether to log messages
# true = log all messages except bot messages
# false = do not log any messages
BOT_LOG_MESSAGE=true

# set maximum retries for connecting to WhatsApp Web if disconnected
BOT_MAX_RETRIES=3

# set an number phone to enable pairing mode (optional)
# example: 6281234567890
BOT_NUMBER_PAIR=

# set an number phone to enable owner mode
# you can set multiple owner numbers separated by commas
# example: 6281234567890,6289876543210
BOT_NUMBER_OWNER=

# set bot session name (default: iyan)
BOT_SESSION_NAME=iyan

# set prefix for bot commands
# you can use pattern, text, or other special characters
BOT_PREFIX="(?:[°•π÷×¶∆£¢€¥®™+✓=|/~!?@#%^&.©^])"

# set whether to allow commands without prefix
BOT_ALLOWED_NO_PREFIX=true # true, false

# set bot reaction status emojis
BOT_REACT_STATUS=❤️,💀,😋,😊,😒,🔥

# set to true to auto-save every incoming media message to ./downloads/
BOT_AUTODL_MEDIA=false # true, false

# set to false to disable forwarding read statuses to your own WhatsApp chat
BOT_FORWARD_STATUS_WA=true # true, false

# set to false to disable auto-saving status photos/videos to ./downloads/status/
BOT_SAVE_STATUS=true # true, false

# custom emoji react per kontak: ./react.json
# format: { "6281234567890": "❤️", "default": "" }
# "default" kosong = pakai acak dari BOT_REACT_STATUS; isi emoji = semua kontak lain pakai itu

# pantau kontak penting -> teruskan pesannya ke Telegram: ./watch.json
# format: { "numbers": ["6281234567890"], "forward_media": true }

# auto-reply rules live in ./autoreply.json (edit the file directly, no restart needed)
# format: { "keyword": "balasan", "halo": "Halo juga!" }
# bot membalas 1x per pesan kalau teks mengandung keyword (case-insensitive), hanya di chat pribadi non-owner

# set your telegram bot token and chat id for sending status messages
# example: https://core.telegram.org/bots/api#authorizing-your-bot
# you can get your bot token from @BotFather
# you can get your chat id from @UserInfoToBot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
BOT_OWNER_NAME=Iyan
